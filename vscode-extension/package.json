{
  "name": "xcoder-vscode",
  "displayName": "Xcoder",
  "description": "Xcoder chat and OpenCode preferences inside VS Code",
  "version": "0.4.4",
  "publisher": "mkdevkit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:xcoder-chat-right",
    "onCommand:xcoder.openChat",
    "onCommand:xcoder.openPreferences",
    "onCommand:xcoder.restartRuntime",
    "onCommand:xcoder.attachToChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xcoder.openChat",
        "title": "Xcoder: Open Chat"
      },
      {
        "command": "xcoder.openPreferences",
        "title": "Xcoder: Open Preferences"
      },
      {
        "command": "xcoder.restartRuntime",
        "title": "Xcoder: Restart OpenCode Runtime"
      },
      {
        "command": "xcoder.attachToChat",
        "title": "Xcoder: Add to Chat"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "xcoder.attachToChat",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Xcoder",
      "properties": {
        "xcoder.opencodePort": {
          "type": "number",
          "default": 4096,
          "description": "Port of the shared OpenCode server. Use the same port as the desktop app to share one OpenCode process."
        },
        "xcoder.opencodeCommand": {
          "type": "string",
          "default": "opencode",
          "description": "OpenCode executable used to launch the local server."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "xcoder-chat-right-container",
          "title": "Xcoder",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "xcoder-chat-right-container": [
        {
          "type": "webview",
          "id": "xcoder-chat-right",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json"
  }
}
